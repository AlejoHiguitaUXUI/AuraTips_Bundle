# ==============================================================================
# AuraTips Microservice — Variables de Entorno de Ejemplo
# Copia este archivo a .env.local y completa con tus credenciales de Supabase
# ==============================================================================

# Supabase Project URL (Pública)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase Anon Key (Pública - Segura para el navegador con RLS activo)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Privada - Solo Servidor / Bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave Secreta para autenticar Webhooks y API del Sistema Madre (M2M)
AURATIPS_SERVICE_SECRET=auratips_secret_token_change_in_production

# URL del Microservicio de Voz EDY (FastAPI + LiveKit en localhost:8000)
NEXT_PUBLIC_VOICE_SERVICE_URL=http://localhost:8000

# Feature Flag para habilitar/ocultar el widget de AURA Voice en la interfaz ("true" o "false")
NEXT_PUBLIC_ENABLE_AURA_VOICE=false
