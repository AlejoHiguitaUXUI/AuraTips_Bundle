{
  "name": "auratips",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/eduplatform-flujo.spec.ts --project=chromium",
    "test:e2e:report": "playwright test e2e/eduplatform-flujo.spec.ts --project=chromium --reporter=html && playwright show-report",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "voice": "cd microservicio-voice && .venv/bin/python voice/main.py dev"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.45.4",
    "@xenova/transformers": "^2.17.2",
    "focus-trap-react": "^12.0.3",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "next": "^15.1.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
